{
  "name": "livslinjen-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Historiskt Wikidata-quiz: 'Vem är personen?' och 'Tidskedjan'",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:candidates": "tsx pipeline/01-candidates.ts",
    "data:entities": "tsx pipeline/02-entities.ts",
    "data:media": "tsx pipeline/03-media.ts",
    "data:build": "tsx pipeline/04-build.ts",
    "data:wiki": "tsx pipeline/05-wikipedia.ts",
    "data": "npm run data:candidates && npm run data:entities && npm run data:media && npm run data:build && npm run data:wiki",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
